{
  "name": "urban-blade-server",
  "version": "1.0.0",
  "description": "Amazon-Grade High-Performance Backend with PostgreSQL and Redis",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "cluster": "tsx src/cluster.ts",
    "build": "tsc && mkdir -p dist/db && cp src/db/products.seed.json dist/db/",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "race-test": "tsx scripts/race-condition-test.ts",
    "test:flow": "tsx scripts/test-e2e-complete-flow.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/under-pressure": "^9.0.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "lru-cache": "^11.0.2",
    "pg": "^8.13.1",
    "razorpay": "^2.9.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "autocannon": "^7.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
