# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# JWT Security
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m

# PostgreSQL / Neon Serverless Postgres
# Local: postgres://urbanblade:urbanblade_secret@localhost:5433/urbanblade_db
# Neon Direct: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# Neon Pooled: postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgres://urbanblade:urbanblade_secret@localhost:5432/urbanblade_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Redis 7.2 Cache & Queue
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=5

# High-Performance Limits
RATE_LIMIT_MAX=5000
RATE_LIMIT_WINDOW_MS=60000
CACHE_TTL_DEFAULT_SEC=300
CACHE_TTL_HOT_SEC=60
MAX_EVENT_LOOP_DELAY_MS=100
MAX_HEAP_USED_BYTES=1073741824

# Trusted storefront origins (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:4200
# Start with keys from your Razorpay test dashboard. Never commit secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
# Migrate explicitly with npm run migrate; never seed production.
AUTO_MIGRATE=false
SEED_DEMO_DATA=false

# Background carrier tracking (requires the shipping account token).
CARRIER_TRACKING_ENABLED=true
DELHIVERY_API_TOKEN=


# ── Urban AI Concierge (customer support chatbot) ──────────────────────────
# Primary online LLM provider. Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=
# Text/instruct-capable model served on NVIDIA NIM. This default is the model
# verified to answer on the free NIM tier as of this commit. If you change it,
# confirm it is live via GET https://integrate.api.nvidia.com/v1/models and a
# test chat completion — several catalog models return HTTP 410 (end-of-life)
# or 404 (not enabled) on the chat endpoint.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# Set to "true" ONLY to allow the anonymous Pollinations.AI proxy as a last
# resort when the configured provider is unavailable. Leave "false" so customer
# support text is never sent to an unconfigured third-party processor.
AI_ALLOW_PUBLIC_FALLBACK=false
