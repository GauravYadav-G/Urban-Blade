# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# JWT Security
JWT_SECRET=super-secret-jwt-token-urbanblade-production-grade-key-100k
JWT_EXPIRES_IN=15m

# PostgreSQL / Neon Serverless Postgres
# Local: postgres://urbanblade:urbanblade_secret@localhost:5433/urbanblade_db
# Neon Direct: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# Neon Pooled: postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgres://urbanblade:urbanblade_secret@localhost:5432/urbanblade_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Redis 7.2 Cache & Queue
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=5

# High-Performance Limits
RATE_LIMIT_MAX=5000
RATE_LIMIT_WINDOW_MS=60000
CACHE_TTL_DEFAULT_SEC=300
CACHE_TTL_HOT_SEC=60
MAX_EVENT_LOOP_DELAY_MS=100
MAX_HEAP_USED_BYTES=1073741824
